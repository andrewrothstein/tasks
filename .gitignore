**~
**/__pycache__
/.project
/.vagrant
.task/
.ansible-roles/
.onetime
.terraform/
tf-validate.json
*.*secrets.yml
*.*secrets.env
*.*secrets.json
openid-configuration.json
rsa-*.key
rsa-*.pub
aad-secret-*.json
*-s3-policy.json
jaffle_shop/
logs/
.dolt/
.kubeconfigs/
*.tigerbeetle
.env
.env.local
.*credentials
.ansible/
**/terraform.tfstate.d/
**/tfplan

# netbootxyz-harvester - rendered configs and secrets
netbootxyz-harvester/
netbootxyz-harvester.env

# netbootxyz - ignore generated/downloaded files, only track customizations
netbootxyz/log/
netbootxyz/menus/remote/
netbootxyz/menus/sigs/
netbootxyz/menus/*.kpxe
netbootxyz/menus/*.efi
netbootxyz/menus/*.ipxe
netbootxyz/menus/boot.cfg
netbootxyz/menus/memdisk
netbootxyz/menus/wimboot
netbootxyz/menus/index.html
netbootxyz/menuversion.txt
netbootxyz/nginx/
# keep local customizations
!netbootxyz/menus/local/

# netbootxyz-assets - large binary artifacts served locally
netbootxyz-assets/

# Beads / Dolt files (added by bd init)
*.db
.beads-credential-key
