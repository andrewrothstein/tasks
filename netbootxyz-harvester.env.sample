# Copy to netbootxyz-harvester.env and fill in values
# netbootxyz-harvester.env is gitignored

# Cluster token (shared secret for nodes to join)
HARVESTER_TOKEN=your-secure-token-here

# Node password
HARVESTER_PASSWORD=your-password-here

# SSH public key for access
SSH_AUTHORIZED_KEY=ssh-rsa AAAA... user@host

# Virtual IP for cluster management
HARVESTER_VIP=192.168.1.200

# Install device (default: /dev/sda)
HARVESTER_INSTALL_DEVICE=/dev/sda
